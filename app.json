{
  "expo": {
    "name": "PlatinumCircles",
    "slug": "tbirds-nest",
    "version": "1.0.0",
    "scheme": "platinum-circles",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.platinumcircles.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PlatinumCircles needs microphone access to let you make voice and video calls with your community.",
        "NSCameraUsageDescription": "PlatinumCircles needs camera access for video calls and profile photos.",
        "NSPhotoLibraryUsageDescription": "PlatinumCircles needs photo access to share images in your conversations and stories.",
        "NSPhotoLibraryAddUsageDescription": "PlatinumCircles needs permission to save photos and videos you receive.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.platinumcircles.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      "expo-image-picker",
      "expo-video",
      [
        "expo-av",
        {
          "microphonePermission": "PlatinumCircles needs microphone access for voice and video calls."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "8cb0cfbe-80b5-477a-b490-fce2f21cd98f"
      }
    },
    "owner": "donadmiral"
  }
}
