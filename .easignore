# Files the phone build never needs. EAS uses this file instead of .gitignore.
node_modules/
**/node_modules/
.git/
.expo/
.next/
**/.next/
**/.turbo/
web/
admin-web/
supabase/
docs/
{*
*.zip
*.mov
*.mp4
*.log
*.ipa
*.aab
*.apk
.vscode/
.idea/
# native folders are generated on EAS from app.json, a stale local copy must never ship
/ios/
/android/
# local junk from .gitignore (EAS reads this file instead of .gitignore)
_audit/
_export/
.ffmpeg/
*.bak
