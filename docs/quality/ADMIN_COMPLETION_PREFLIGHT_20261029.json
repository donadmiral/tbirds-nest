{
  "date": "2026-10-29",
  "project": "prlkikhckbifseosbukl",
  "scope": "Read-only prerequisites for forward admin completion after four applied repairs",
  "preflight": {
    "functions": [
      {
        "acl": "{postgres=X/postgres,service_role=X/postgres}",
        "md5": "724b53f1cb512e9ad043cbe52175c9e9",
        "signature": "admin_ops.require_session(uuid,uuid,text)",
        "definition": "CREATE OR REPLACE FUNCTION admin_ops.require_session(p_actor_id uuid, p_session_id uuid, p_permission text)\n RETURNS text\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$\ndeclare r text;\nbegin\n -- The same native session used by the verified server token must still exist.\n if p_actor_id is null or p_session_id is null\n    or not public.triniti_admin_session_check(p_actor_id,p_session_id)\n    or not exists(select 1 from auth.sessions where id=p_session_id and user_id=p_actor_id and aal::text in ('aal1','aal2'))\n then raise exception 'ACTIVE_ADMIN_SESSION_REQUIRED' using errcode='42501'; end if;\n perform 1 from auth.sessions s join auth.users u on u.id=s.user_id\n where s.id=p_session_id and s.user_id=p_actor_id and s.aal::text in ('aal1','aal2')\n and (s.not_after is null or s.not_after>now()) and u.deleted_at is null\n and (u.banned_until is null or u.banned_until<=now()) for share of s,u;\n if not found then raise exception 'ACTIVE_ADMIN_SESSION_REQUIRED' using errcode='42501'; end if;\n select role into r from public.admin_users where user_id=p_actor_id and active for share;\n if not coalesce(case p_permission\n when 'support' then r=any(array['super_admin','platform_admin','trust_safety','support_agent'])\n when 'report_listing' then r=any(array['super_admin','platform_admin','trust_safety','market_reviewer'])\n else false end,false) then raise exception 'ADMIN_PERMISSION_DENIED' using errcode='42501'; end if;\n return r;\nend $function$\n"
      },
      {
        "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
        "md5": "706c0f581043206c3b26145f61b5bf93",
        "signature": "sync_post_comment_count()",
        "definition": "CREATE OR REPLACE FUNCTION public.sync_post_comment_count()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  if tg_op = 'INSERT' then\r\n    update posts\r\n    set comments_count = (\r\n      select count(*) from post_comments where post_id = new.post_id\r\n    )\r\n    where id = new.post_id;\r\n    return new;\r\n  elsif tg_op = 'DELETE' then\r\n    update posts\r\n    set comments_count = (\r\n      select count(*) from post_comments where post_id = old.post_id\r\n    )\r\n    where id = old.post_id;\r\n    return old;\r\n  end if;\r\n  return null;\r\nend;\r\n$function$\n"
      },
      {
        "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
        "md5": "00b2a9b71c3294399c0bf5d9127febf8",
        "signature": "sync_post_comments_count()",
        "definition": "CREATE OR REPLACE FUNCTION public.sync_post_comments_count()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  -- Only count top-level comments (not replies)\r\n  update posts set comments_count = (\r\n    select count(*) from post_comments\r\n    where post_id = coalesce(NEW.post_id, OLD.post_id)\r\n    and parent_comment_id is null\r\n  ) where id = coalesce(NEW.post_id, OLD.post_id);\r\n  return coalesce(NEW, OLD);\r\nend;\r\n$function$\n"
      },
      {
        "acl": "{postgres=X/postgres,service_role=X/postgres}",
        "md5": "ba2e1c694288129ee94d8b6d06746eef",
        "signature": "triniti_admin_session_check(uuid,uuid)",
        "definition": "CREATE OR REPLACE FUNCTION public.triniti_admin_session_check(p_user_id uuid, p_session_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\r\n  SELECT EXISTS (\r\n    SELECT 1\r\n    FROM auth.sessions s\r\n    JOIN auth.users u ON u.id = s.user_id\r\n    JOIN public.admin_users a ON a.user_id = s.user_id\r\n    WHERE s.id = p_session_id AND s.user_id = p_user_id\r\n      AND (s.not_after IS NULL OR s.not_after > now())\r\n      AND u.deleted_at IS NULL\r\n      AND (u.banned_until IS NULL OR u.banned_until <= now())\r\n      AND a.active IS TRUE\r\n      AND a.role IN ('super_admin','platform_admin','trust_safety','support_agent','ops_engineer',\r\n                     'market_reviewer','jobs_reviewer','verification_reviewer','finance_admin','analyst','auditor_readonly')\r\n  );\r\n$function$\n"
      },
      {
        "acl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
        "md5": "9797ae6166b3788b5850a18aeac16f04",
        "signature": "update_comment_count()",
        "definition": "CREATE OR REPLACE FUNCTION public.update_comment_count()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  if tg_op = 'INSERT' then\r\n    update posts set comments_count = comments_count + 1 where id = new.post_id;\r\n  elsif tg_op = 'DELETE' then\r\n    update posts set comments_count = comments_count - 1 where id = old.post_id;\r\n  end if;\r\n  return null;\r\nend;\r\n$function$\n"
      }
    ],
