    "**/.git/**",
    "**/.env*"
  ],
  "additional_inputs": [
    "web/next-env.d.ts",
    "admin-web/next-env.d.ts"
  ],
  "algorithm": "SHA-256 over sorted UTF-8 path, NUL, lowercase file SHA-256, LF records"
}
