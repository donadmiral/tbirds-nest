    "initialStateMeaning": "Migration/test expectation. Read actual values from the target; this is not an installed-state observation.",
    "originalUploads": {
      "state": "music_library.service_state.uploads_enabled",
      "operatorRpc": "public.set_original_audio_service_ready(boolean,text)",
      "steps": [
        "Verify finalizer/signer/proxy/erasure bundles and all migrations.",
        "Enable only in disposable QA for the real upload/finalize/preview/story-post-book/audience/revoke/erase journey.",
        "Record complete hosted acceptance before separate production readiness; disable on failure."
      ]
    },
    "maintenance": {
      "state": "music_library.maintenance_worker.enabled",
      "operatorRpc": "public.set_music_maintenance_ready(boolean,text)",
      "steps": [
        "Deploy the worker only after both operations and catalogue migrations; it services both queues.",
        "Run setup-music-maintenance-credential.sql; the scoped secret remains in Vault as music_maintenance_worker_secret.",
        "Store the exact project URL in Vault as music_maintenance_project_url; verify it targets this project.",
        "Verify exact deployed source and expected authentication rejection while disabled, then enable maintenance through its service-only RPC in QA.",
        "Invoke using the scoped credential and verify response plus heartbeat; validation intentionally does not update heartbeat while disabled.",
        "Install install-music-maintenance-cron.sql and inspect cron plus HTTP outcomes and worker heartbeat.",
        "Run actual disposable abandoned-upload Storage cleanup before production readiness; quota releases only after verified object absence."
      ]
    },
    "catalogue": {
      "states": [
        "music_library.catalogue_service.ingestion_enabled",
        "music_library.catalogue_service.playback_enabled"
      ],
      "activationProvided": false,
      "steps": [
        "Keep both switches off; this handoff provisions no commercial credentials, agreements or licensed-provider state.",
        "After real licensing review, use separately reviewed signed-grant/provider/territory setup and acceptance based on actual provider requirements.",
        "Staging metadata does not authorize ingestion, playback, reuse or export."
      ]
