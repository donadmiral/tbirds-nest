      "owner": "postgres",
      "definition": "CREATE OR REPLACE FUNCTION public.upsert_link_preview(p_url text, p_title text DEFAULT NULL::text, p_description text DEFAULT NULL::text, p_image_url text DEFAULT NULL::text, p_domain text DEFAULT NULL::text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n  update public.link_previews\r\n    set title = coalesce(p_title, title),\r\n        description = coalesce(p_description, description),\r\n        image_url = coalesce(p_image_url, image_url),\r\n        domain = coalesce(p_domain, domain),\r\n        fetched_at = now()\r\n    where url = p_url;\r\n  if not found then\r\n    insert into public.link_previews (url, title, description, image_url, domain, fetched_at)\r\n    values (p_url, p_title, p_description, p_image_url, p_domain, now());\r\n  end if;\r\nend;\r\n$function$\n"
    }
