{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Four retained Live integration credentials in us-east-2, encrypted with the existing bootstrap KMS key. No IAM, compute, provider credentials or admission changes.",
  "Resources": {
    "TranscriptionWorker": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/transcription/worker"
        },
        "Description": "Dedicated Live transcription worker bearer; pair with LIVE_TRANSCRIPTION_WORKER_SECRET.",
        "KmsKeyId": "arn:aws:kms:us-east-2:518317808503:key/c0502962-cac0-4244-b722-31dfa2fa8fed",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true,
          "IncludeSpace": false,
          "ExcludeUppercase": false,
          "ExcludeLowercase": false,
          "ExcludeNumbers": false,
          "RequireEachIncludedType": false
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "PlatinumCircles"
          },
          {
            "Key": "Purpose",
            "Value": "LiveIntegrationCredentials"
          }
        ]
      }
    },
    "TranscriptionQueue": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/transcription/queue"
        },
        "Description": "Queue metadata only; pair with LIVE_TRANSCRIPTION_QUEUE_SECRET. Separate from worker authority.",
        "KmsKeyId": "arn:aws:kms:us-east-2:518317808503:key/c0502962-cac0-4244-b722-31dfa2fa8fed",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true,
          "IncludeSpace": false,
          "ExcludeUppercase": false,
          "ExcludeLowercase": false,
          "ExcludeNumbers": false,
          "RequireEachIncludedType": false
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "PlatinumCircles"
          },
          {
            "Key": "Purpose",
            "Value": "LiveIntegrationCredentials"
          }
        ]
      }
    },
    "SocialWorker": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/social/worker"
        },
        "Description": "Dedicated Live social worker bearer; pair with LIVE_SOCIAL_WORKER_SECRET.",
        "KmsKeyId": "arn:aws:kms:us-east-2:518317808503:key/c0502962-cac0-4244-b722-31dfa2fa8fed",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludePunctuation": true,
          "IncludeSpace": false,
          "ExcludeUppercase": false,
          "ExcludeLowercase": false,
          "ExcludeNumbers": false,
          "RequireEachIncludedType": false
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "PlatinumCircles"
          },
          {
            "Key": "Purpose",
            "Value": "LiveIntegrationCredentials"
          }
        ]
      }
    },
    "OAuthVaultSeed": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/oauth/vault-seed"
        },
        "Description": "OAuth vault seed: 64 lowercase hexadecimal characters encoding 32 random bytes. Convert privately to unpadded base64url under key ID live20261103.",
        "KmsKeyId": "arn:aws:kms:us-east-2:518317808503:key/c0502962-cac0-4244-b722-31dfa2fa8fed",
        "GenerateSecretString": {
          "PasswordLength": 64,
          "ExcludeUppercase": true,
          "ExcludeLowercase": false,
          "ExcludeNumbers": false,
          "ExcludePunctuation": true,
          "IncludeSpace": false,
          "ExcludeCharacters": "ghijklmnopqrstuvwxyz",
          "RequireEachIncludedType": false
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "PlatinumCircles"
          },
          {
            "Key": "Purpose",
            "Value": "LiveIntegrationCredentials"
          }
        ]
      }
    }
  },
  "Outputs": {
    "TranscriptionWorkerSecretArn": {
      "Value": {
        "Ref": "TranscriptionWorker"
      }
    },
    "TranscriptionQueueSecretArn": {
      "Value": {
        "Ref": "TranscriptionQueue"
      }
    },
    "SocialWorkerSecretArn": {
      "Value": {
        "Ref": "SocialWorker"
      }
    },
    "OAuthVaultSeedSecretArn": {
      "Value": {
        "Ref": "OAuthVaultSeed"
      }
    },
    "WorkerCredentialEncoding": {
      "Value": "64 ASCII alphanumeric characters; install the exact string without whitespace or re-encoding."
    },
    "VaultSeedEncoding": {
      "Value": "64 lowercase hex characters = 32 bytes; decode hex, encode unpadded base64url, place in LIVE_INTEGRATION_VAULT_KEYS JSON."
    },
    "VaultKeyId": {
      "Value": "live20261103"
    }
  }
}
