# Configure these for the intended environment before npm run build.
# Preview deployments must use their isolated backend's credentials.
# Keep the service-role key server-only; never add NEXT_PUBLIC_ to its name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Exact additional admin origins allowed to request/redeem recovery links.
# VERCEL_URL and VERCEL_BRANCH_URL are accepted automatically when Vercel sets them.
# Add each origin + /reset-password/callback to this Supabase project's Auth redirect allowlist.
# Do not add wildcards or ordinary app/IntoBank origins here.
ADMIN_AUTH_ORIGINS=
